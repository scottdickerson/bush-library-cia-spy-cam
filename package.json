{
  "name": "cia-spycam",
  "version": "2.1.0",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev -- --dev",
    "camera:green": "electron-vite dev -- --dev --camera --filter=green",
    "camera:thermal": "electron-vite dev -- --dev --camera --filter=thermal",
    "camera:whitehot": "electron-vite dev -- --dev --camera --filter=whitehot",
    "build": "electron-vite build",
    "start": "electron-vite build && electron .",
    "typecheck": "tsc --noEmit",
    "selftest": "electron-vite build && SPYCAM_SELFTEST=1 electron . --dev",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "org.bushlibrary.cia-spycam",
    "productName": "CIA Spycam",
    "files": [
      "out/**"
    ],
    "win": {
      "target": "zip"
    }
  }
}
